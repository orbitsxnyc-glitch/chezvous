# URL publique de l'API Laravel (pas de secret ici). Le web et l'API doivent partager le même site
# (ex. localhost:3000 et localhost:8000 en local) pour que les cookies de session Sanctum fonctionnent.
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL de l'API appelée côté serveur (rendu des pages publiques) ; défaut : NEXT_PUBLIC_API_URL.
API_URL=http://localhost:8000
# URL publique du site (balises canoniques, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
